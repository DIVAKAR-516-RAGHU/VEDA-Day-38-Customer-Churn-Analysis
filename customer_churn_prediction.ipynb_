   "id": "54d299f8-bc2f-4512-ba8a-4408dce356de",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Duplicate rows before cleaning: 0\n",
      "\n",
      "Missing values before handling:\n"
     ]
