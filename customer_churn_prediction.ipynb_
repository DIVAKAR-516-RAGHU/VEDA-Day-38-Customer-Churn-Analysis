    "output_dir = Path(\"outputs\")\n",
    "output_dir.mkdir(exist_ok=True)\n",
    "\n",
    "# Save evaluation results and analysis tables\n",
    "results_df.to_csv(output_dir / \"model_comparison.csv\")\n",
    "importance_df.to_csv(output_dir / \"feature_importance.csv\", index=False)\n",
    "recommendations_df.to_csv(\n",
    "    output_dir / \"retention_recommendations.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Save cleaned dataset for reference\n",
    "df_clean.to_csv(output_dir / \"cleaned_churn_dataset.csv\", index=False)\n",
    "\n",
    "print(\"Saved files:\")\n",
    "for path in sorted(output_dir.iterdir()):\n",
    "    print(\"-\", path)\n"
   ]
