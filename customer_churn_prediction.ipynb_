   "source": [
    "\n",
    "retention_actions = {\n",
    "    \"Contract\": (\n",
    "        \"Offer suitable longer-term plans, transparent pricing, \"\n",
    "        \"and renewal incentives.\"\n",
    "    ),\n",
    "    \"TenureGroup\": (\n",
    "        \"Provide onboarding support, proactive follow-ups, \"\n",
    "        \"and early-customer loyalty benefits.\"\n",
    "    ),\n",
    "    \"InternetService\": (\n",
    "        \"Review service quality, connection issues, and suitable \"\n",
    "        \"internet plans for the customer.\"\n",
    "    ),\n",
    "    \"PaymentMethod\": (\n",
    "        \"Investigate payment friction and offer convenient payment \"\n",
    "        \"options where appropriate.\"\n",
    "    )\n",
    "}\n",
    "\n",
    "recommendations = []\n",
    "\n",
    "overall_churn_rate = (model_df[\"Churn\"] == \"Yes\").mean() * 100\n",
    "\n",
    "for column, action in retention_actions.items():\n",
    "    segment_rates = churn_rate_table(model_df, column)\n",
    "\n",
    "    for segment, row in segment_rates.iterrows():\n",
    "        recommendations.append({\n",
    "            \"Segment Type\": column,\n",
    "            \"Customer Segment\": str(segment),\n",
    "            \"Customers\": int(row[\"Customers\"]),\n",
    "            \"Observed Churn Rate (%)\": row[\"Churn Rate (%)\"],\n",
    "            \"Above Overall Churn Rate\": (\n",
    "                row[\"Churn Rate (%)\"] > overall_churn_rate\n",
    "            ),\n",
    "            \"Suggested Action\": action\n",
    "        })\n",
    "\n",
    "recommendations_df = pd.DataFrame(recommendations)\n",
    "\n",
    "recommendations_df = recommendations_df.sort_values(\n",
    "    [\"Above Overall Churn Rate\", \"Observed Churn Rate (%)\"],\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "print(f\"Overall observed churn rate: {overall_churn_rate:.2f}%\")\n",
    "display(recommendations_df)\n",
    "\n",
    "print(\"\\nPriority segments for further investigation:\")\n",
    "display(\n",
    "    recommendations_df[\n",
    "        recommendations_df[\"Above Overall Churn Rate\"]\n",
    "    ].head(10)\n",
    ")\n"
   ]
  },
