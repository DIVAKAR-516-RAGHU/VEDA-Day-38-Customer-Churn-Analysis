   ],
   "source": [
    "\n",
    "def churn_rate_table(data, column):\n",
    "    table = (\n",
    "        data.groupby(column, observed=True)[\"Churn\"]\n",
    "        .agg(\n",
    "            Customers=\"size\",\n",
    "            Churned=lambda s: (s == \"Yes\").sum()\n",
    "        )\n",
    "    )\n",
    "\n",
    "    table[\"Churn Rate (%)\"] = (\n",
    "        table[\"Churned\"] / table[\"Customers\"] * 100\n",
    "    )\n",
    "\n",
    "    return table.sort_values(\"Churn Rate (%)\", ascending=False).round(2)\n",
    "\n",
    "\n",
    "for column in [\"Contract\", \"TenureGroup\", \"InternetService\", \"PaymentMethod\"]:\n",
    "    print(f\"\\nChurn analysis by {column}:\")\n",
    "    display(churn_rate_table(model_df, column))\n"
   ]
  },
