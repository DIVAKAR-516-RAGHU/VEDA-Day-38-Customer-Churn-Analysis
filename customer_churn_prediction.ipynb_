    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Missing TotalCharges with zero tenure: 11\n",
      "\n",
      "Remaining missing values:\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "customerID         0\n",
       "gender             0\n",
       "SeniorCitizen      0\n",
       "Partner            0\n",
       "Dependents         0\n",
       "tenure             0\n",
       "PhoneService       0\n",
       "MultipleLines      0\n",
       "InternetService    0\n",
       "OnlineSecurity     0\n",
       "dtype: int64"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Cleaned dataset shape: (7043, 21)\n"
     ]
    }
   ],
   "source": [
    "\n",
    "df_clean = df.copy()\n",
    "\n",
    "# Remove duplicate customer records, if any\n",
    "print(\"Duplicate rows before cleaning:\", df_clean.duplicated().sum())\n",
    "df_clean = df_clean.drop_duplicates().copy()\n",
    "\n",
    "# Remove accidental whitespace from column names and text values\n",
    "df_clean.columns = df_clean.columns.str.strip()\n",
    "\n",
    "for col in df_clean.select_dtypes(include=\"object\").columns:\n",
    "    df_clean[col] = df_clean[col].str.strip()\n",
    "\n",
    "# Convert TotalCharges into a numeric column\n",
    "df_clean[\"TotalCharges\"] = pd.to_numeric(\n",
    "    df_clean[\"TotalCharges\"], errors=\"coerce\"\n",
    ")\n",
    "\n",
    "print(\"\\nMissing values before handling:\")\n",
    "display(df_clean.isnull().sum().sort_values(ascending=False).head(10))\n",
    "\n",
    "# Blank TotalCharges generally represents customers with zero tenure.\n",
    "zero_tenure_missing = (\n",
    "    df_clean[\"TotalCharges\"].isna()\n",
    "    & (df_clean[\"tenure\"] == 0)\n",
    ").sum()\n",
    "\n",
    "print(\"Missing TotalCharges with zero tenure:\", zero_tenure_missing)\n",
    "\n",
    "# Treat these blank charges as zero, consistent with zero tenure.\n",
    "df_clean.loc[\n",
    "    df_clean[\"TotalCharges\"].isna()\n",
    "    & (df_clean[\"tenure\"] == 0),\n",
    "    \"TotalCharges\"\n",
    "] = 0\n",
    "\n",
    "print(\"\\nRemaining missing values:\")\n",
    "display(df_clean.isnull().sum().sort_values(ascending=False).head(10))\n",
    "\n",
    "print(\"\\nCleaned dataset shape:\", df_clean.shape)\n"
   ]
  },
