      "Churn prediction function created successfully.\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def predict_customer_churn(customer_details, model=best_model):\n",
    "    \"\"\"\n",
    "    Predict churn for one customer.\n",
    "\n",
    "    customer_details:\n",
    "        Dictionary containing the original dataset's predictor columns,\n",
    "        excluding customerID and Churn.\n",
    "    \"\"\"\n",
    "    customer = pd.DataFrame([customer_details])\n",
    "\n",
    "    required_columns = X.columns.tolist()\n",
    "    missing_columns = [c for c in required_columns if c not in customer.columns]\n",
    "    extra_columns = [c for c in customer.columns if c not in required_columns]\n",
    "\n",
    "    if missing_columns:\n",
    "        raise ValueError(f\"Missing customer fields: {missing_columns}\")\n",
    "\n",
    "    if extra_columns:\n",
    "        raise ValueError(f\"Unexpected fields: {extra_columns}\")\n",
    "\n",
    "    # Match training feature order\n",
    "    customer = customer[required_columns]\n",
    "\n",
    "    probability = float(model.predict_proba(customer)[0][\n",
    "        list(model.classes_).index(1)\n",
    "    ])\n",
    "\n",
    "    prediction = int(probability >= 0.5)\n",
    "\n",
    "    if probability >= 0.70:\n",
    "        risk = \"High\"\n",
    "    elif probability >= 0.40:\n",
    "        risk = \"Medium\"\n",
    "    else:\n",
    "        risk = \"Low\"\n",
    "\n",
    "    return {\n",
    "        \"Predicted Churn\": \"Yes\" if prediction else \"No\",\n",
    "        \"Churn Probability (%)\": round(probability * 100, 2),\n",
    "        \"Risk Category\": risk\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"Churn prediction function created successfully.\")\n"
   ]
  },
